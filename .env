# Bu dosya bir ŞABLONDUR — gerçek anahtarları buraya yazma.
# Yerelde çalıştırmak için: bu dosyayı ".env" olarak kopyala ve gerçek değerleri gir.
# ".env" dosyası .gitignore'da olduğu için asla GitHub'a gitmez.

# Groq API anahtarı (console.groq.com)
GROQ_API_KEY=

# PostgreSQL bağlantı adresi (Supabase/Railway panelinden alınır)
DATABASE_URL=

# Pinecone API anahtarı (app.pinecone.io)
PINECONE_API_KEY=

# admin kullanıcısının şifresi (boş bırakılırsa varsayılan "admin123" kullanılır)
ADMIN_PASSWORD=


# Pollinations.ai API anahtarı (auth.pollinations.ai üzerinden ücretsiz kayıt) - opsiyonel
# Boş bırakırsan görsel oluşturma yine çalışır, sadece anonim (daha düşük) hız limitiyle
POLLINATIONS_API_KEY=


